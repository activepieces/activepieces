{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "AP_EDITION",
    "AP_DB_TYPE",
    "AP_REDIS_HOST",
    "AP_REDIS_PORT",
    "AP_POSTGRES_HOST",
    "AP_POSTGRES_PORT",
    "AP_POSTGRES_USERNAME",
    "AP_POSTGRES_PASSWORD",
    "AP_POSTGRES_DATABASE",
    "LOG_FILE",
    "LOG_LEVEL",
    "LOG_PRETTY",
    "AP_LOG_FILE",
    "AP_LOG_LEVEL",
    "AP_LOG_PRETTY",
    "AP_SMTP_HOST",
    "AP_SMTP_PORT",
    "AP_SMTP_USERNAME",
    "AP_SMTP_PASSWORD",
    "AP_SMTP_SENDER_EMAIL",
    "AP_SMTP_SENDER_NAME",
    "AP_TOOL_SEARCH_ENABLED",
    "AP_OPENAI_API_KEY",
    "AP_PIECES_SYNC_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/packages/server/tsconfig.server.json",
        "src/**",
        "tsconfig*.json",
        "package.json",
        "!src/**/*.spec.ts",
        "!src/**/*.test.ts",
        "!vitest.config.*"
      ]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "outputs": ["../../dist/packages/web/**"],
      "env": ["AP_BUILD_SOURCEMAP"],
      "inputs": [
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/packages/server/tsconfig.server.json",
        "$TURBO_DEFAULT$",
        "!src/**/*.spec.ts",
        "!src/**/*.spec.tsx",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!test/**",
        "!vitest.config.*"
      ]
    },
    "api#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/packages/server/tsconfig.server.json",
        "src/**",
        "types/**",
        "tsconfig*.json",
        "package.json",
        "!src/**/*.spec.ts",
        "!src/**/*.test.ts"
      ]
    },
    "@activepieces/engine#build": {
      "dependsOn": [],
      "outputs": ["../../../dist/packages/engine/**"],
      "inputs": [
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/packages/server/tsconfig.server.json",
        "src/**",
        "$TURBO_ROOT$/packages/core/shared/src/**",
        "$TURBO_ROOT$/packages/core/shared/package.json",
        "$TURBO_ROOT$/packages/pieces/framework/src/**",
        "$TURBO_ROOT$/packages/pieces/framework/package.json",
        "$TURBO_ROOT$/packages/pieces/common/src/**",
        "$TURBO_ROOT$/packages/pieces/common/package.json",
        "$TURBO_ROOT$/packages/core/utils/src/**",
        "$TURBO_ROOT$/packages/core/utils/package.json",
        "$TURBO_ROOT$/packages/core/piece-types/src/**",
        "$TURBO_ROOT$/packages/core/piece-types/package.json",
        "$TURBO_ROOT$/packages/core/formula/src/**",
        "$TURBO_ROOT$/packages/core/formula/package.json",
        "$TURBO_ROOT$/packages/core/execution/src/**",
        "$TURBO_ROOT$/packages/core/execution/package.json",
        "tsconfig*.json",
        "package.json",
        "esbuild.config.mjs",
        "!src/**/*.spec.ts",
        "!src/**/*.test.ts"
      ]
    },
    "ee-embed-sdk#bundle": {
      "dependsOn": [],
      "inputs": [
        "src/**",
        "tsconfig*.json",
        "package.json",
        "webpack.config.js"
      ],
      "outputs": ["../../../dist/packages/ee/embed-sdk/**"],
      "cache": false
    },
    "ee-embed-sdk#build": {
      "dependsOn": ["^build"],
      "outputs": ["../../../dist/packages/ee/embed-sdk/**"],
      "inputs": ["$TURBO_ROOT$/tsconfig.base.json", "src/**", "tsconfig*.json", "package.json", "!src/**/*.spec.ts", "!src/**/*.test.ts"]
    },
    "@activepieces/cli#build": {
      "dependsOn": ["^build"],
      "outputs": ["../../dist/packages/cli/**"],
      "inputs": ["$TURBO_ROOT$/tsconfig.base.json", "src/**", "tsconfig*.json", "package.json", "!src/**/*.spec.ts", "!src/**/*.test.ts"]
    },
    "bundle": {
      "dependsOn": ["build", "@activepieces/cli#build"],
      "inputs": ["src/**", "package.json"],
      "outputs": ["dist/index.bundle.js", "dist/package.json"]
    },
    "@activepieces/engine#test": {
      "dependsOn": [
        "build",
        "@activepieces/piece-http#build",
        "@activepieces/piece-data-mapper#build",
        "@activepieces/piece-approval#build",
        "@activepieces/piece-webhook#build",
        "@activepieces/piece-delay#build"
      ],
      "inputs": ["src/**", "test/**", "tsconfig*.json", "vitest.config.*"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "inputs": ["src/**", "test/**", "scripts/**", ".eslintrc.json", "../../.eslintrc.json"],
      "outputs": []
    },
    "web#lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "scripts/**", ".eslintrc.json", "../../.eslintrc.json"],
      "outputs": []
    },
    "@activepieces/shared#lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "scripts/**", ".eslintrc.json", "../../.eslintrc.json"],
      "outputs": []
    },
    "api#lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "scripts/**", ".eslintrc.json", "../../.eslintrc.json"],
      "outputs": []
    },
    "@activepieces/engine#lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "scripts/**", ".eslintrc.json", "../../.eslintrc.json"],
      "outputs": []
    },
    "@activepieces/sandbox#lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "scripts/**", ".eslintrc.json", "../../.eslintrc.json"],
      "outputs": []
    },
    "worker#lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "scripts/**", ".eslintrc.json", "../../.eslintrc.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "tsconfig*.json", "vitest.config.*", "package.json"],
      "outputs": ["coverage/**"]
    },
    "test-unit": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test-ce": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test-ee": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test-cloud": {
      "dependsOn": ["build"],
      "cache": false
    },
    "check-migrations": {
      "dependsOn": ["build"],
      "cache": false
    },
    "db-migration": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "serve": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json", "$TURBO_ROOT$/packages/server/tsconfig.server.json"],
      "outputs": []
    }
  }
}
