{
  "name": "@activepieces/piece-10ml-perfume",
  "version": "0.1.0",
  "description": "Activepieces piece for the free 10ML Perfume Finder: search perfumes, note pyramids, accords, similar scents, alternatives, notes and houses from the 10ML Fragrance Index. No API key.",
  "keywords": [
    "activepieces",
    "activepieces-piece",
    "perfume",
    "fragrance",
    "perfume-api",
    "fragrance-api",
    "perfume-recommendation",
    "similar-perfumes",
    "fragrance-notes"
  ],
  "license": "MIT",
  "homepage": "https://10ml.com/perfume-mcp-server",
  "author": {
    "name": "10ML Team",
    "email": "contact@10ml.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/10ml/perfume-finder-mcp.git"
  },
  "bugs": {
    "url": "https://gitlab.com/10ml/perfume-finder-mcp/-/issues"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "dependencies": {
    "@activepieces/pieces-common": "workspace:*",
    "@activepieces/pieces-framework": "workspace:*",
    "@activepieces/core-piece-types": "workspace:*",
    "@activepieces/core-utils": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && cp package.json dist/",
    "bundle": "node ../../../../dist/packages/cli/src/index.js pieces bundle",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "3.2.6",
    "tslib": "2.6.2"
  }
}
