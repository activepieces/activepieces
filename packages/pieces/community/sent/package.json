{
  "name": "@activepieces/piece-sent",
  "version": "0.0.1",
  "description": "Multi-channel SMS, WhatsApp, and RCS messaging with Sent.",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && cp package.json dist/",
    "bundle": "node ../../../../dist/packages/cli/src/index.js pieces bundle",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@activepieces/pieces-common": "workspace:*",
    "@activepieces/pieces-framework": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.11.0",
    "tslib": "2.6.2",
    "vitest": "3.2.6"
  }
}
